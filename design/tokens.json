        "acc-1": "#0FA67A",
        "acc-2": "#E5446D",
        "acc-3": "#2DC993"
      },
      "orangePink": {
        "acc-1": "#E8590C",
        "acc-2": "#DB3F7C",
        "acc-3": "#F5A524"
      },
      "cyanIndigo": {
        "acc-1": "#0FA3BD",
        "acc-2": "#5B5BE0",
        "acc-3": "#2F6FED"
      },
      "greenAmber": {
        "acc-1": "#1FA95B",
        "acc-2": "#E8920C",
        "acc-3": "#7BB32E"
      }
    }
  },
  "radius": {
    "xs": 8,
    "s": 10,
    "m": 16,
    "l": 22,
    "pill": 999
  },
  "space": {
    "3xs": 4,
    "2xs": 6,
    "xs": 8,
    "s": 10,
    "m": 12,
