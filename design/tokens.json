{
  "_about": "The single source of truth for Insulin Buddy's look. `node tools/make-tokens.mjs` turns this into tokens.css (the web app) and design/DesignTokens.swift (the future iOS app). Change a value here, regenerate, and the whole app follows. Never edit those two generated files by hand.",
  "color": {
    "light": {
      "ink": "#1B2A3A", "ink-soft": "#6B7A89", "paper": "#F5F3EE", "surface": "#FFFFFF", "line": "#E4E1D8",
      "amber": "#C8862E", "brick": "#A34A3B", "brick-soft": "#F1DCD6", "green": "#4C7A5E"
    },
    "dark": {
      "ink": "#ECEAE3", "ink-soft": "#9AA6B2", "paper": "#14181D", "surface": "#1C2127", "line": "#2B3138", "brick-soft": "#3A2420"
    }
  },
  "palette": {
    "default": "blueViolet",
    "set": {
      "tealViolet":  { "acc-1": "#1F9E93", "acc-2": "#8B5CF6", "acc-3": "#38BDF8" },
      "blueViolet":  { "acc-1": "#3B82F6", "acc-2": "#8B5CF6", "acc-3": "#6366F1" },
      "emeraldRose": { "acc-1": "#10B981", "acc-2": "#F43F5E", "acc-3": "#34D399" },
      "orangePink":  { "acc-1": "#F97316", "acc-2": "#EC4899", "acc-3": "#F59E0B" },
      "cyanIndigo":  { "acc-1": "#22B8CE", "acc-2": "#6366F1", "acc-3": "#3B82F6" },
      "greenAmber":  { "acc-1": "#22C55E", "acc-2": "#F59E0B", "acc-3": "#84CC16" }
    }
  },
  "radius": { "xs": 8, "s": 10, "m": 16, "l": 22, "pill": 999 },
  "space": { "3xs": 4, "2xs": 6, "xs": 8, "s": 10, "m": 12, "l": 16, "xl": 24 },
  "type": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "display": "var(--font-ui)"
    },
    "size": {
      "2xs": 0.68, "xs": 0.74, "s": 0.8, "m": 0.86, "l": 0.92, "body": 1,
      "h3": 1.1, "h2": 1.3, "h1": 1.4
    }
  },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "glass": {
    "light": {
      "bg": "rgba(255,255,255,0.60)", "bg-strong": "rgba(255,255,255,0.78)", "edge": "rgba(255,255,255,0.75)",
      "edge-soft": "rgba(255,255,255,0.28)", "line": "rgba(27,42,58,0.07)",
      "shadow": "0 10px 28px rgba(27,42,58,0.08), 0 2px 6px rgba(27,42,58,0.04)"
    },
    "dark": {
      "bg": "rgba(34,40,47,0.58)", "bg-strong": "rgba(48,56,65,0.75)", "edge": "rgba(255,255,255,0.16)",
      "edge-soft": "rgba(255,255,255,0.05)", "line": "rgba(0,0,0,0.35)",
      "shadow": "0 10px 28px rgba(0,0,0,0.35), 0 2px 6px rgba(0,0,0,0.25)"
    },
    "blur": "blur(22px) saturate(1.7)"
  }
}
