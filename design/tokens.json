{
  "_about": "The single source of truth for Insulin Buddy's look. `node tools/make-tokens.mjs` turns this into tokens.css (the web app) and design/DesignTokens.swift (the future iOS app). Change a value here, regenerate, and the whole app follows. Never edit those two generated files by hand. Colours follow Apple's iOS system palette (system colours, grouped backgrounds, true-black dark mode).",
  "color": {
    "light": {
      "ink": "#000000",
      "ink-soft": "#6C6C70",
      "paper": "#F2F2F7",
      "surface": "#FFFFFF",
      "line": "#D1D1D6",
      "amber": "#C93400",
      "brick": "#D70015",
      "brick-soft": "#FFE5E6",
      "green": "#248A3D"
    },
    "dark": {
      "ink": "#FFFFFF",
      "ink-soft": "#A1A1A6",
      "paper": "#000000",
      "surface": "#1C1C1E",
      "line": "#38383A",
      "amber": "#FF9230",
      "brick": "#FF4245",
      "brick-soft": "#3A1D1F",
      "green": "#30D158"
    }
  },
  "palette": {
    "default": "blueIndigo",
    "set": {
      "redOrange": {
        "acc-1": "#D70015",
        "acc-2": "#FF8D28",
        "acc-3": "#D70015",
        "acc-1-dark": "#FF4245",
        "acc-2-dark": "#FF9230"
      },
      "orangeYellow": {
        "acc-1": "#C93400",
        "acc-2": "#FFCC00",
        "acc-3": "#C93400",
        "acc-1-dark": "#FF9230",
        "acc-2-dark": "#FFD600"
      },
      "greenMint": {
        "acc-1": "#248A3D",
        "acc-2": "#00C8B3",
        "acc-3": "#248A3D",
        "acc-1-dark": "#30D158",
        "acc-2-dark": "#00DAC3"
      },
      "tealCyan": {
        "acc-1": "#008299",
        "acc-2": "#00C0E8",
        "acc-3": "#008299",
        "acc-1-dark": "#00D2E0",
        "acc-2-dark": "#3CD3FE"
      },
      "blueIndigo": {
        "acc-1": "#0088FF",
        "acc-2": "#6155F5",
        "acc-3": "#0088FF",
        "acc-1-dark": "#0091FF",
        "acc-2-dark": "#6D7CFF"
      },
      "purplePink": {
        "acc-1": "#CB30E0",
        "acc-2": "#FF2D55",
        "acc-3": "#CB30E0",
        "acc-1-dark": "#DB34F2",
        "acc-2-dark": "#FF375F"
      }
    }
  },
  "radius": {
    "xs": 8,
    "s": 10,
    "m": 16,
    "l": 22,
    "pill": 999
  },
  "space": {
    "3xs": 4,
    "2xs": 6,
    "xs": 8,
    "s": 10,
    "m": 12,
    "l": 16,
    "xl": 24
  },
  "type": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "display": "var(--font-ui)"
    },
    "size": {
      "2xs": 0.69,
      "xs": 0.74,
      "s": 0.8,
      "m": 0.86,
      "l": 0.92,
      "body": 1,
      "h3": 1.1,
      "h2": 1.3,
      "h1": 1.4
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "glass": {
    "light": {
      "bg": "rgba(255,255,255,0.60)",
      "bg-strong": "rgba(255,255,255,0.78)",
      "edge": "rgba(255,255,255,0.75)",
      "edge-soft": "rgba(255,255,255,0.28)",
      "line": "rgba(60,60,67,0.08)",
      "shadow": "0 10px 28px rgba(27,42,58,0.08), 0 2px 6px rgba(27,42,58,0.04)"
    },
    "dark": {
      "bg": "rgba(28,28,30,0.60)",
      "bg-strong": "rgba(44,44,46,0.78)",
      "edge": "rgba(255,255,255,0.16)",
      "edge-soft": "rgba(255,255,255,0.05)",
      "line": "rgba(0,0,0,0.35)",
      "shadow": "0 10px 28px rgba(0,0,0,0.35), 0 2px 6px rgba(0,0,0,0.25)"
    },
    "blur": "blur(22px) saturate(1.7)"
  },
  "contrast": {
    "light": {
      "ink-soft": "#48484A",
      "line": "#AEAEB2"
    },
    "dark": {
      "ink-soft": "#D1D1D6",
      "line": "#636366"
    }
  }
}
