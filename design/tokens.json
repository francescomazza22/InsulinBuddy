      "body": 1,
      "h3": 1.1,
      "h2": 1.3,
      "h1": 1.4
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
